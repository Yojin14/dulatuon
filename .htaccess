<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/ [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L,QSA]
</IfModule>

# Block access to sensitive files
<FilesMatch "^\.env|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan">
    Order allow,deny
    Deny from all
</FilesMatch>
